#!/system/bin/sh

##############################################################################
##
##  Gradle start up script for POSIX generated by Gradle.
##
##############################################################################

# Add default JVM options here.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")

# Determine the Java command to use
JAVACMD=java

# Find the Java installation
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
fi

# Attempt to set APP_HOME
PRG="$0"
while [ -h "$PRG" ]; do
    ls=$(ls -ld "$PRG")
    link=$(expr "$ls" : '.*-> \(.*\)$')
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG=$(dirname "$PRG")/"$link"
    fi
done
APP_HOME=$(cd "$(dirname "$PRG")" > /dev/null && pwd)

# Use the minimum number of quotation marks to preserve command-line spaces
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine main class from wrapper
MAIN_CLASS=org.gradle.wrapper.GradleWrapperMain

exec "$JAVACMD" $DEFAULT_JVM_OPTS -classpath "$CLASSPATH" "$MAIN_CLASS" "$@"
